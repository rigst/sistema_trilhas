[Unit]
Description=Celery Worker + Beat — Trilhas de Estudo
After=network.target redis-server.service

[Service]
User=rod
Group=www-data
WorkingDirectory=/var/www/sistema_trilhas
EnvironmentFile=/var/www/sistema_trilhas/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/var/www/sistema_trilhas/venv/bin/celery -A config worker --beat -l info
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
