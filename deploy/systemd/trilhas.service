[Unit]
Description=Trilhas de Estudo (Gunicorn)
After=network.target

[Service]
Type=simple
User=rod
Group=www-data
WorkingDirectory=/var/www/sistema_trilhas
EnvironmentFile=/var/www/sistema_trilhas/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/var/www/sistema_trilhas/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8013 \
    --workers 3 \
    --timeout 300 \
    --access-logfile /var/www/sistema_trilhas/logs/gunicorn.access.log \
    --error-logfile /var/www/sistema_trilhas/logs/gunicorn.error.log
Restart=always
RestartSec=5
KillSignal=SIGQUIT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
