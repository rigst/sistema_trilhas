# Nginx — Trilhas de Estudo (trilhas.stolben.com)

server {
    server_name trilhas.stolben.com;

    client_max_body_size 20M;

    location /static/ {
        alias /var/www/sistema_trilhas/staticfiles/;
        expires 30d;
    }
    location /media/ {
        alias /var/www/sistema_trilhas/media/;
    }
    location / {
        proxy_pass http://127.0.0.1:8013;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 300s;
    }

    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/trilhas.stolben.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/trilhas.stolben.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    listen [::]:80;
    server_name trilhas.stolben.com;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}
