# Nginx — Trilhas de Estudo (trilhas.stolben.com)
# HTTP-only. Rode `certbot --nginx -d trilhas.stolben.com` para adicionar o HTTPS.

server {
    listen 80;
    server_name trilhas.stolben.com;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    client_max_body_size 20M;

    location /static/ {
        alias /var/www/sistema_trilhas/staticfiles/;
        expires 30d;
    }
    location /media/ {
        alias /var/www/sistema_trilhas/media/;
    }
    location / {
        proxy_pass http://127.0.0.1:8013;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_read_timeout 300s;
    }
}
