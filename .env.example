# Variáveis de Ambiente — Trilhas de Estudo
# Copie para .env e ajuste os valores.

SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis — cache/sessão (django_redis) E broker/result do Celery.
# IMPORTANTE: use um DB EXCLUSIVo deste app. No servidor:
# divisor_pdf=1, sistema_questoes=2, sistema_vetorial=0, sistema_trilhas=3.
REDIS_URL=redis://localhost:6379/3

# PostgreSQL (produção) — usado apenas por config.settings.production
DB_NAME=sistema_trilhas
DB_USER=sistema_trilhas
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# IA — Anthropic / Claude
ANTHROPIC_API_KEY=
# Modelo geral (perguntas, conteúdo, avaliação, exercícios) — Sonnet 4.6 (rápido/barato)
AI_MODEL=claude-sonnet-4-6
# Modelo de planejamento (sumário) e correção de dissertativas — Opus 4.8 (mais julgamento)
AI_MODEL_PLANEJAMENTO=claude-opus-4-8
AI_EFFORT=high
AI_EFFORT_GERAL=medium
AI_MAX_TOKENS=16000
AI_MAX_TOKENS_CONTEUDO=32000
# Preços por 1M tokens (USD): Opus 4.8 = 5/25, Sonnet 4.6 = 3/15 (definidos em settings.AI_PRICES)
AI_PRICE_INPUT_PER_MTOK=5.0
AI_PRICE_OUTPUT_PER_MTOK=25.0

# Quotas mensais de tokens
QUOTA_TOKENS_DEFAULT=3000000
QUOTA_TOKENS_VISITOR=300000

# Vídeo do tópico (slideshow narrado). Requer ffmpeg no sistema e
# `playwright install chromium` no venv. Voz feminina: pt-BR-FranciscaNeural.
VIDEO_TTS_VOICE=pt-BR-AntonioNeural
VIDEO_FFMPEG_BIN=ffmpeg
VIDEO_FFPROBE_BIN=ffprobe
# Música de fundo: vazio = escolhida automaticamente pela categoria da trilha
# (static/audio/*.ogg). Definir um caminho força uma faixa fixa em todos os vídeos.
VIDEO_MUSICA_PATH=
# Trechos codificados ao mesmo tempo na montagem. 0 = pelo número de núcleos
# (no máximo 2, já que a mesma máquina serve o site). Suba só se sobrar CPU.
VIDEO_WORKERS=0

# Visitante / limpeza
VISITOR_EXPIRY_HOURS=48
CLEANUP_INTERVAL_MINUTES=60

# Regra da trilha
NOTA_MINIMA_APROVACAO=7.0
